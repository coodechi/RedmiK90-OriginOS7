# ==============================================================================
# Device Configuration: REDMI K90 (annibale / SM8750 sun)
# Measured from HyperOS 4 (OS4.0.6.0.XPKCNXM) via Stage 1 inspection report
# ==============================================================================

DEVICE_CODENAME="annibale"
DEVICE_MARKETNAME="REDMI K90"
DEVICE_SOC="SM8750"

# Physical super & dynamic partition group limits (bytes)
SUPER_SIZE_BYTES=13421772800
SUPER_GROUP_MAX_BYTES=13411287040

# Safety headroom reserved for liblp metadata, 1 MiB alignment & fastbootd overhead (64 MiB)
SUPER_SAFETY_MARGIN_BYTES=67108864

# K90 hardware/vendor partitions kept untouched on device (bytes):
#   odm_a         = 3,318,341,632
#   vendor_a      =   742,670,336
#   vendor_dlkm_a =    55,910,400
#   system_dlkm_a =    15,294,464
#   Total         = 4,132,216,832 (~3,940.80 MiB)
K90_KEPT_PARTITIONS_BYTES=4132216832

# K90 stock Base ROM official Xiaomi CDN URL
K90_BASE_ROM_URL="https://cdnorg.d.miui.com/OS4.0.6.0.XPKCNXM/annibale_images_OS4.0.6.0.XPKCNXM_20261026.0000.00_17.0_cn_8129267a3b.tgz"

# K90 product displayconfig XML to carry into OriginOS product partition
K90_PRODUCT_DISPLAYCONFIG="etc/displayconfig/display_id_4630947238302509459.xml"

# OriginOS 7 (iQOO Neo 11 PD2520) OEM variant to flatten into /oem/oem.prop
# PD2520_CN-ZH_FULL_SC_NULL = China retail unlocked full-netcom (no carrier customization)
VIVO_OEM_VARIANT="PD2520_CN-ZH_FULL_SC_NULL"

# Default EROFS compression & fixed timestamp (matches stock 2009-01-01 00:00:00 UTC)
DEFAULT_EROFS_COMPRESS="lz4hc,9"
EROFS_TIMESTAMP="1230768000"
